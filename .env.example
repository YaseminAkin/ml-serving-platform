# Copy to .env and adjust. Every value here is the built-in default.
DATABASE_URL=postgresql+asyncpg://mlserving:mlserving@localhost:5432/mlserving
REDIS_URL=redis://localhost:6379
API_KEY=dev

# Mirror live traffic to the registered shadow version
SHADOW_ENABLED=false

# LLM-judge scoring in the eval worker is skipped while this is empty
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-4o-mini

EVAL_POLL_INTERVAL_SECONDS=5
EVAL_BATCH_SIZE=20
DRIFT_CHECK_INTERVAL_SECONDS=3600
DRIFT_WINDOW_SIZE=500
DRIFT_THRESHOLD=0.1
